# Project URL and publishable key (legacy anon key also supported).
# No service-role/secret key is needed for sign-in and protected read routes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only runtime overrides (use these for runtime-only config).
# Leave these lines commented when using the NEXT_PUBLIC settings above.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

# Optional QR bridge hosted on a persistent service (not needed for wa.me links).
WHATSAPP_BRIDGE_URL=
WHATSAPP_BRIDGE_TOKEN=

# Optional server-side Google Sheets sync. Never prefix these secrets NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=1KTxNabq2oEw-kevJEBj2J4BZ7ZTd21fisIALeGkXMs0
CRON_SECRET=
