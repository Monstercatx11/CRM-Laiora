# Project URL and publishable key (legacy anon key also supported).
# No service-role/secret key is needed for sign-in and protected read routes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only runtime overrides (use these for runtime-only config).
# Leave these lines commented when using the NEXT_PUBLIC settings above.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
