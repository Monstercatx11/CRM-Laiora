# Separate persistent host; never put these secrets in NEXT_PUBLIC_* variables.
HOST=127.0.0.1
PORT=3100
DATA_DIR=/var/lib/laiora-whatsapp
WHATSAPP_ACCOUNT_REF=laiora-main
WHATSAPP_BRIDGE_TOKEN=
# Generate exactly 32 random bytes, encoded as base64. Keep this key after restart.
WHATSAPP_SESSION_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
